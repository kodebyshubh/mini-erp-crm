{
  "info": {
    "name": "Mini ERP + CRM Operations Portal",
    "description": "API collection for the Mini ERP + CRM Operations Portal case study backend. Set base_url and run 'Login (Admin)' first - the token is auto-saved to the collection variable and reused by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://mini-erp-crm-23b3.onrender.com" },
    { "key": "token", "value": "" },
    { "key": "customer_id", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "challan_id", "value": "" },
    { "key": "po_id", "value": "" },
    { "key": "invoice_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.test\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"sales@erp.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Warehouse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"warehouse@erp.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Accounts)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"accounts@erp.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/customers?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "", "disabled": true },
                { "key": "customerType", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('customer_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Traders\",\n  \"mobile\": \"9000000000\",\n  \"email\": \"sample@traders.example\",\n  \"businessName\": \"Sample Traders Pvt Ltd\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"1 Main Road\",\n  \"status\": \"LEAD\"\n}"
            },
            "url": { "raw": "{{base_url}}/customers", "host": ["{{base_url}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Get customer by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}"]
            }
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}"]
            }
          }
        },
        {
          "name": "Add follow-up note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called customer, will place order next week.\",\n  \"followUpDate\": \"2026-08-20\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}/follow-ups",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}", "follow-ups"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "lowStock", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('product_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Product\",\n  \"sku\": \"SKU-TEST-001\",\n  \"category\": \"General\",\n  \"unitPrice\": 100,\n  \"stock\": 50,\n  \"minStock\": 5,\n  \"location\": \"Warehouse A\"\n}"
            },
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"unitPrice\": 110\n}" },
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Record stock movement (IN/OUT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 10,\n  \"movementType\": \"IN\",\n  \"reason\": \"Manual stock correction\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/stock-movements",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "stock-movements"]
            }
          }
        },
        {
          "name": "List stock movements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/stock-movements?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["products", "stock-movements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Challans",
      "item": [
        {
          "name": "List challans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/challans?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "status", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create challan (Draft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('challan_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    { \"productId\": \"{{product_id}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/challans", "host": ["{{base_url}}"], "path": ["challans"] }
          }
        },
        {
          "name": "Get challan by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/challans/{{challan_id}}",
              "host": ["{{base_url}}"],
              "path": ["challans", "{{challan_id}}"]
            }
          }
        },
        {
          "name": "Confirm challan (deducts stock)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/challans/{{challan_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["challans", "{{challan_id}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancel challan (reverses stock if confirmed)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/challans/{{challan_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["challans", "{{challan_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Purchase Orders",
      "item": [
        {
          "name": "List purchase orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/purchase-orders?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["purchase-orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Create purchase order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('po_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierName\": \"ACME Supplies\",\n  \"items\": [\n    { \"productId\": \"{{product_id}}\", \"quantity\": 20 }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/purchase-orders", "host": ["{{base_url}}"], "path": ["purchase-orders"] }
          }
        },
        {
          "name": "Get purchase order by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/purchase-orders/{{po_id}}",
              "host": ["{{base_url}}"],
              "path": ["purchase-orders", "{{po_id}}"]
            }
          }
        },
        {
          "name": "Receive purchase order (adds stock)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/purchase-orders/{{po_id}}/receive",
              "host": ["{{base_url}}"],
              "path": ["purchase-orders", "{{po_id}}", "receive"]
            }
          }
        },
        {
          "name": "Cancel purchase order",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/purchase-orders/{{po_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["purchase-orders", "{{po_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "List invoices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/invoices?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Generate invoice from confirmed challan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('invoice_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"challanId\": \"{{challan_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/invoices", "host": ["{{base_url}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "Get invoice by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["invoices", "{{invoice_id}}"]
            }
          }
        },
        {
          "name": "Download invoice PDF",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/invoices/{{invoice_id}}/pdf",
              "host": ["{{base_url}}"],
              "path": ["invoices", "{{invoice_id}}", "pdf"]
            }
          }
        }
      ]
    }
  ]
}
