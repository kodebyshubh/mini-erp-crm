# PostgreSQL connection string used by Prisma (pooled, e.g. Supabase port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/mini_erp_crm?schema=public"

# Direct (non-pooled) connection, used only for `prisma migrate deploy`. Same as DATABASE_URL locally;
# on Supabase use the port 5432 direct connection string here.
DIRECT_URL="postgresql://erp_user:erp_password@localhost:5432/mini_erp_crm?schema=public"

# Port the Express server listens on
PORT=4000

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET="change-this-to-a-long-random-secret"

# JWT expiry (jsonwebtoken format, e.g. 1d, 12h, 30m)
JWT_EXPIRES_IN="1d"

# Comma separated list of allowed CORS origins for the frontend
CORS_ORIGIN="http://localhost:5173"
